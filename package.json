{
  "name": "markcraft",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "MarkCraft - Crafted Markdown Reader & In-Browser WYSIWYG Editor Extension",
  "license": "MIT",
  "homepage": "https://github.com/markcraft-dev/markcraft",
  "repository": {
    "type": "git",
    "url": "https://github.com/markcraft-dev/markcraft.git"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build:wasm": "node scripts/build_wasm.mjs",
    "build": "npm run build:wasm && node scripts/build.mjs",
    "test:unit": "pnpm exec tsc src/content/core/doc-url.ts src/content/core/sanitize.ts src/content/core/slug.ts --target es2022 --module es2022 --outDir tests/.tmp --skipLibCheck && node --test tests/doc-url.test.mjs tests/export-sanitize.test.mjs tests/slug.test.mjs"
  },
  "dependencies": {
    "@mdit/plugin-alert": "^1.0.3",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.3.2",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^26.5.1",
    "@unocss/vite": "^0.58.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.3.3",
    "unocss": "^0.58.6",
    "vite": "^5.1.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
